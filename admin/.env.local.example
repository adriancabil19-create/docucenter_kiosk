# ─── Admin authentication ────────────────────────────────────────────────────
# The console has no user database — these three server-side vars ARE the
# credentials. To rotate a leaked password, change ADMIN_PASSWORD *and*
# SESSION_SECRET, then redeploy (see admin/README.md → Credential rotation).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long
# Signs the session cookie. Use 32+ random chars. Changing it invalidates every
# existing login immediately.
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars

# ─── Backend API (server-side only — never exposed to the browser) ────────────
# URL of the docucenter-kiosk backend server.
# Development: http://localhost:5000
# Production:  https://grand-tenderness-production-b632.up.railway.app
API_URL=http://localhost:5000
# Required when the backend has ADMIN_API_TOKEN configured. Sent only from the
# Next.js server via the /api/backend/* proxy.
ADMIN_API_TOKEN=

# ─── Legacy (deprecated) ─────────────────────────────────────────────────────
# Older deployments used NEXT_PUBLIC_API_URL / NEXT_PUBLIC_ADMIN_API_TOKEN.
# Those shipped the token to the browser — do not use them. They are still read
# as a fallback so existing deploys keep working; migrate to the names above.
